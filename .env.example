# ═════════════════════════════════════════════════════════════════════════════╗
# Ejemplo de variables para docker compose (entorno local)
# Copia este archivo como ".env" en la raíz del repo y ajusta lo que quieras:
#   cp .env.example .env
# El archivo .env NO se sube al repo (está ignorado en .git).
# ═════════════════════════════════════════════════════════════════════════════╝

# ── PostgreSQL (contenedor) ───────────────────────────────────────────────────
POSTGRES_DB=eventos
POSTGRES_USER=eventos_user
POSTGRES_PASSWORD=cambiame123

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_aleatoria_de_minimo_32_chars
JWT_EXPIRATION_MS=86400000

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_PORT=3000
# Puerto de acceso directo a la API del backend (http://localhost:8081):
BACKEND_PORT=8081

# ── Certificados ──────────────────────────────────────────────────────────────
CERT_ORGANIZACION=Gestion de Eventos S.A.
# Sin Cloudinary los PDF se regeneran en memoria (no hay URL pública permanente):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Correo ────────────────────────────────────────────────────────────────────
# Por defecto se usa Mailpit: buzón local en http://localhost:8025 (sin cuenta).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eventos.local
# JAVA_TOOL_OPTIONS desactiva auth/STARTTLS para que Mailpit funcione.
JAVA_TOOL_OPTIONS="-Dspring.mail.properties.mail.smtp.auth=false -Dspring.mail.properties.mail.smtp.starttls.enable=false -Dspring.mail.properties.mail.smtp.starttls.required=false"
# Para enviar correo real (Gmail) usa en su lugar:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tuemail@gmail.com
#   MAIL_PASSWORD=<App Password de Google>
#   MAIL_FROM=tuemail@gmail.com
#   JAVA_TOOL_OPTIONS="-Dspring.mail.properties.mail.smtp.auth=true -Dspring.mail.properties.mail.smtp.starttls.enable=true -Dspring.mail.properties.mail.smtp.starttls.required=true"

# ── Frontend ──────────────────────────────────────────────────────────────────
# /api => nginx (dentro del contenedor frontend) proxya al backend. No cambiar.
VITE_API_URL=/api