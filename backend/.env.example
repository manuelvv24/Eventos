# ═══════════════════════════════════════════════════════════════════════════
# Variables de entorno requeridas en Railway (backend)
# Copia este archivo como referencia al configurar tu servicio en Railway.
# NUNCA subas el archivo .env real al repositorio.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────────────────────
# Railway genera DATABASE_URL automáticamente al agregar un plugin PostgreSQL.
DATABASE_URL=jdbc:postgresql://HOST:PORT/DBNAME
PGUSER=postgres
PGPASSWORD=tu_password_de_bd

# ── JWT ──────────────────────────────────────────────────────────────────────
# Usa una cadena larga y aleatoria (mínimo 64 caracteres).
JWT_SECRET=cambiar_por_clave_muy_larga_y_aleatoria_de_minimo_64_chars
JWT_EXPIRATION_MS=86400000

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Obtenlos en: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Correo Gmail SMTP ────────────────────────────────────────────────────────
# Usa una "Contraseña de aplicación" de Google (no tu contraseña normal).
# Actívala en: Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de app
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tuemail@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_FROM=tuemail@gmail.com

# ── URLs ─────────────────────────────────────────────────────────────────────
# URL pública de tu frontend desplegado en Railway / Vercel / Netlify
FRONTEND_URL=https://tu-frontend.up.railway.app

# ── Certificados ─────────────────────────────────────────────────────────────
CERT_ORGANIZACION=Nombre de tu organización

# ── Scheduler de notificaciones (opcional, default: 60000 ms = 1 minuto) ─────
NOTIFICACIONES_SCHEDULER_DELAY_MS=60000
